# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monitor_precios_it?schema=public"

# Production (Supabase):
# Use the direct connection string (puerto 5432) for local migration setup:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.oawdjjlmvmfnpshgbnix.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require"
#
# For Vercel and GitHub Actions (session pooler, puerto 6543):
# DATABASE_URL="postgresql://postgres.[oawdjjlmvmfnpshgbnix]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
SERP_API_KEY="tu_clave_de_api"
# Alternative accepted alias if your provider/secret is already named this way:
# SERPAPI_API_KEY="tu_clave_de_api"
SERP_PROVIDER="serpapi"
CRON_SECRET="cambiar_por_un_token_largo"
SCRAPER_MAX_COMPANIES_PER_RUN="25"
SCRAPER_TARGET_CITY="Cordoba,Cordoba Province,Argentina"
DB_ALLOW_SELF_SIGNED_CERT="false"
NODE_ENV="development"
